# URL del proyecto: Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (formato sb_publishable_...). También se acepta la clave "anon" heredada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (formato sb_secret_...) o "service_role" heredada. SOLO SERVIDOR: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Correo del propietario: su primer ingreso lo registra como owner.
OWNER_EMAIL=
